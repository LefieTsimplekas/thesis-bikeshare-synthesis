# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Data (too large for git) ──────────────────────────────────────────────────
data/raw/
# processed: εξαιρούνται τα δεδομένα, κρατιούνται τα μικρά manifests των splits
# (ημέρες και SHA-256 του κλειδωμένου London test) για αναπαραγωγιμότητα
data/processed/*
!data/processed/*_split_manifest.json
data/tmp/
data/synthetic/
data/model_input/
data/query.sql
data/raw.zip

# Context: keep directory structure, exclude large/regenerable files
data/context/weather/
data/context/topography/
data/context/urban_form/
data/context/**/*.parquet

# OSM (05a/05b/05c): εξαιρούνται το οδικό δίκτυο και το cache του OSMnx,
# κρατιούνται τα osm_meta_{city}.json (ημερομηνία λήψης, μεγέθη)
data/context/osm/*.graphml
data/context/osm/cache/

# ── Artifacts ─────────────────────────────────────────────────────────────────
# Exclude large/regenerable experiment outputs
artifacts/oracle_london/

# Keep small reproducibility artifacts
!artifacts/model_input/
!artifacts/model_input/final_feature_columns_*.json
!artifacts/model_input/continuous_scaler_*.joblib
!artifacts/data_quality/
!artifacts/data_quality/data_quality_report.csv

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Office temp files ─────────────────────────────────────────────────────────
~$*.docx
~$*.xlsx
~WRL*.tmp

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── Misc ─────────────────────────────────────────────────────────────────────
cache/
*.log
# ── Literature ─────────────────────────────────────────────────────────────────────
Literature/

# ── Thesis ─────────────────────────────────────────────────────────────────────
Thesis/

# ── Notes ─────────────────────────────────────────────────────────────────────
Σημειωσεις/